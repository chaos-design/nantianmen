# 本地开发环境变量模板。复制为 .env 后填写，不要把真实值提交到仓库。
# Vercel 部署时不要上传本文件；改为在 Project Settings 中按
# Development / Preview / Production 分别配置同名变量。
# 完整说明见 docs/development-guide.md 和 docs/deployment-guide.md。

# Supabase 持久化。
RESUME_DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 私有图片 Bucket 名，留空则使用 resume-assets，必须与 supabase/platform.sql 一致。
SUPABASE_STORAGE_BUCKET=

# 浏览器认证。构建阶段写入客户端产物，修改后需重新构建或重新部署。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 已确认的管理员账号。
ADMIN_USER_ID=

# 只读 Preview 账号，四项必须同时配置。
PREVIEW_USER_ID=
PREVIEW_USER_EMAIL=
PREVIEW_RESUME_ID=
PREVIEW_SESSION_SECRET=

# 可选的全局 AI Provider，三项必须同时配置；这些配置会下发给已认证的可编辑用户。
AI_MODEL_NAME=
AI_BASE_URL=
AI_API_KEY=

# 以下变量只用于 Playwright 隔离测试，由 playwright.config.ts 在测试进程中注入，
# 不要写进本地 .env，也不要配置到任何部署环境。
# 生产环境检测到 AUTH_TEST_* 会直接拒绝启动。
# AUTH_TEST_USER_ID=
# AUTH_TEST_USER_EMAIL=
# RESUME_FILE_DATABASE_PATH=
# RESUME_FILE_ASSET_DIR=
